# GoreeCloud Vault Server production deployment template
# Copy this file to an operator-controlled root-owned location outside the
# repository, replace every CHANGEME value, and chmod the real file 0600.

# Production consumes immutable manifests only. Mutable tags are not release evidence.
# GOREVAULT_* variable names remain compatibility-oriented deployment identifiers so
# existing operator configuration does not need a risky rename-only migration.
GOREVAULT_IMAGE=ghcr.io/goreecloud/goreecloud-vault-server@sha256:CHANGEME_64_HEX_DIGEST
POSTGRES_IMAGE=docker.io/library/postgres@sha256:CHANGEME_64_HEX_DIGEST

# Dedicated non-root GoreeCloud Vault Server runtime identity.
GOREVAULT_UID=10001
GOREVAULT_GID=10001

# Canonical public origin. TLS terminates at the trusted GoreeCloud reverse proxy.
GOREVAULT_DOMAIN=https://vault.goreecloud.com
# Backend publication stays loopback-only on the host.
GOREVAULT_HTTP_PORT=8080

POSTGRES_DB=goreevault
POSTGRES_USER=goreevault
# Generate a long URL-safe random secret; never commit the real value.
POSTGRES_PASSWORD=CHANGEME_LONG_RANDOM_DATABASE_PASSWORD

# GoreeCloud default: closed public registration.
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true

# GoreeCloud default: /admin disabled. If deliberately enabled later, use an
# Argon2 PHC token and restrict the route to the administrative network/NetBird policy.
ADMIN_TOKEN=

# Optional SMTP. Leave SMTP_HOST blank until mail is configured.
# Transactional mail currently retains the GoreeVault client-family identity.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=admin@goreecloud.com
SMTP_FROM_NAME=GoreeVault
SMTP_USERNAME=
SMTP_PASSWORD=

EVENTS_DAYS_RETAIN=90
TRASH_AUTO_DELETE_DAYS=30
INCOMPLETE_2FA_TIME_LIMIT=3
