# GoreeVault production deployment template
# Copy to a root-owned deployment secret file outside the repository, chmod 600,
# and replace every CHANGEME value before running Compose.

# Production must consume immutable registry manifests. Do not use :latest,
# :dev, or a mutable semantic tag as deployment evidence.
GOREVAULT_IMAGE=ghcr.io/goreecloud/goreevault-server@sha256:CHANGEME_64_HEX_DIGEST
POSTGRES_IMAGE=docker.io/library/postgres@sha256:CHANGEME_64_HEX_DIGEST

# GoreeVault runs non-root in production. Changing these values intentionally
# triggers a one-time recursive ownership repair of the /data volume.
GOREVAULT_UID=10001
GOREVAULT_GID=10001

# Public origin terminated by the trusted reverse proxy.
GOREVAULT_DOMAIN=https://vault.goreecloud.com
GOREVAULT_HTTP_PORT=8080

POSTGRES_DB=goreevault
POSTGRES_USER=goreevault
# Use at least 32 URL-safe random characters because this value is embedded in DATABASE_URL.
# Example generator: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGEME_LONG_RANDOM_DATABASE_PASSWORD

# Production registration is closed unless an operator deliberately changes it.
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true

# Leave blank to disable /admin. If enabled, use an Argon2 PHC ADMIN_TOKEN;
# never place a plaintext administrator password here.
ADMIN_TOKEN=

# Optional SMTP. Leave SMTP_HOST blank until mail is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=admin@goreecloud.com
SMTP_FROM_NAME=GoreeVault
SMTP_USERNAME=
SMTP_PASSWORD=

EVENTS_DAYS_RETAIN=90
TRASH_AUTO_DELETE_DAYS=30
INCOMPLETE_2FA_TIME_LIMIT=3
