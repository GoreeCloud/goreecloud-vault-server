# GoreeVault development deployment
# Copy to deploy/.env, chmod 600, then replace every CHANGEME value.

# Production target: https://vault.goreecloud.com
# Initial local development target:
GOREVAULT_DOMAIN=http://localhost:8080

POSTGRES_DB=goreevault
POSTGRES_USER=goreevault
POSTGRES_PASSWORD=CHANGEME_LONG_RANDOM_DATABASE_PASSWORD

# Keep public self-registration disabled by default.
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true

# Leave blank to keep /admin disabled until you intentionally configure an
# Argon2 PHC ADMIN_TOKEN. Do not use a plaintext admin password in production.
ADMIN_TOKEN=

# Optional SMTP configuration. Leave SMTP_HOST blank until mail is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=admin@goreecloud.com
SMTP_FROM_NAME=GoreeVault
SMTP_USERNAME=
SMTP_PASSWORD=

# Retain security events for 90 days in the initial GoreeCloud policy.
EVENTS_DAYS_RETAIN=90
TRASH_AUTO_DELETE_DAYS=30
INCOMPLETE_2FA_TIME_LIMIT=3
