<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" data-theme="system">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="same-origin" />
    <meta name="description" content="Private GoreeVault administration for GoreeCloud." />
    <title>GoreeVault Admin</title>
    <script src="{{urlpath}}/vw_static/admin.js"></script>
    <link rel="stylesheet" href="{{urlpath}}/vw_static/bootstrap.css" />
    <link rel="stylesheet" href="{{urlpath}}/vw_static/admin.css" />
</head>
<body class="gv-admin-body">
    <a class="gv-skip-link" href="#gv-main">Skip to main content</a>

    <svg xmlns="http://www.w3.org/2000/svg" class="d-none" aria-hidden="true">
        <symbol id="vw-icon-sun" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="5" fill="currentColor"/>
            <g stroke="currentColor" stroke-linecap="round" stroke-width="1.5">
                <path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/>
            </g>
        </symbol>
        <symbol id="vw-icon-moon" viewBox="0 0 24 24">
            <path fill="currentColor" stroke-width=".8" d="M18.4 17.8A9 8.6 0 0 1 13 2a10.5 10.5 0 1 0 9 14.4 9.4 9 0 0 1-3.6 1.4"/>
        </symbol>
        <symbol id="vw-icon-auto" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/>
            <path fill="currentColor" d="M12 3a9 9 0 1 1 0 18Z"/>
        </symbol>
    </svg>

    <header class="gv-site-header fixed-top">
        <nav class="navbar navbar-expand-md" aria-label="GoreeVault administration">
            <div class="container-xxl">
                <a class="navbar-brand gv-brand" href="{{urlpath}}/admin" aria-label="GoreeVault Admin home">
                    <span class="gv-brand-mark">GoreeVault</span>
                    <span class="gv-brand-product">Admin</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                    aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <ul class="navbar-nav me-auto gv-primary-nav">
                        {{#if logged_in}}
                        <li class="nav-item">
                            <a class="nav-link" href="{{urlpath}}/admin">Settings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{urlpath}}/admin/users/overview">Users</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{urlpath}}/admin/organizations/overview">Organizations</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{urlpath}}/admin/diagnostics">Diagnostics</a>
                        </li>
                        {{/if}}
                        <li class="nav-item">
                            <a class="nav-link" href="{{urlpath}}/" target="_blank" rel="noreferrer">Vault</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav mx-md-3 gv-header-actions">
                        <li class="nav-item dropdown">
                            <button
                                class="btn gv-theme-toggle dropdown-toggle d-flex align-items-center"
                                id="bd-theme" type="button" aria-expanded="false" data-bs-toggle="dropdown"
                                data-bs-display="static" aria-label="Appearance (System)">
                                <span class="theme-icon-active" aria-hidden="true">
                                    <svg class="vw-theme-icon" focusable="false" aria-hidden="true">
                                        <use data-theme-icon-use href="#vw-icon-auto"></use>
                                    </svg>
                                </span>
                                <span class="ms-2" id="bd-theme-text">Appearance</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="bd-theme-text">
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center active"
                                        data-bs-theme-value="system" aria-pressed="true">
                                        <span class="me-2 theme-icon" aria-hidden="true">
                                            <svg class="vw-theme-icon" focusable="false" aria-hidden="true">
                                                <use data-theme-icon-use href="#vw-icon-auto"></use>
                                            </svg>
                                        </span>
                                        System
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center"
                                        data-bs-theme-value="light" aria-pressed="false">
                                        <span class="me-2 theme-icon" aria-hidden="true">
                                            <svg class="vw-theme-icon" focusable="false" aria-hidden="true">
                                                <use data-theme-icon-use href="#vw-icon-sun"></use>
                                            </svg>
                                        </span>
                                        Light
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center"
                                        data-bs-theme-value="dark" aria-pressed="false">
                                        <span class="me-2 theme-icon" aria-hidden="true">
                                            <svg class="vw-theme-icon" focusable="false" aria-hidden="true">
                                                <use data-theme-icon-use href="#vw-icon-moon"></use>
                                            </svg>
                                        </span>
                                        Dark
                                    </button>
                                </li>
                            </ul>
                        </li>
                    </ul>

                    {{#if logged_in}}
                    <a class="btn btn-sm gv-secondary-action" href="{{urlpath}}/admin/logout">Log out</a>
                    {{/if}}
                </div>
            </div>
        </nav>
    </header>

    {{> (lookup this "page_content") }}

    <script src="{{urlpath}}/vw_static/bootstrap.bundle.js"></script>
</body>
</html>
